{
  "name": "retailing/retail",
  "description": "Retail marketplace product component",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "cataloging/catalog": "dev-master",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "tabling/table": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "interfacing/interface": "dev-master",
    "locating/location": "dev-master",
    "objecting/object": "dev-master",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/options-resolver": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/validator": "^8.1",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0",
    "symfony/panther": "^2.3",
    "symfony/test-pack": "^1.2"
  },
  "autoload": {
    "psr-4": {
      "App\\Retailing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Retailing\\Tests\\": "tests/"
    }
  },
  "repositories": [
    { "type": "path", "url": "../Administering", "options": { "symlink": true } },
    { "type": "path", "url": "../Cataloging", "options": { "symlink": true } },
    { "type": "path", "url": "../Cruding", "options": { "symlink": true } },
    { "type": "path", "url": "../Collectioning", "options": { "symlink": true } },
    { "type": "path", "url": "../Tabling", "options": { "symlink": true } },
    { "type": "path", "url": "../Interfacing", "options": { "symlink": true } },
    { "type": "path", "url": "../Locating", "options": { "symlink": true } },
    { "type": "path", "url": "../Navigating", "options": { "symlink": true } },
    { "type": "path", "url": "../Objecting", "options": { "symlink": true } },
    { "type": "path", "url": "../Viewing", "options": { "symlink": true } }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse -c phpstan.neon",
    "test": "phpunit",
    "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text=var/coverage.txt --path-coverage",
    "schema:parity": [
      "php bin/console doctrine:schema:validate --env=test",
      "php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "gate": "@php .gating/bin/gating check --target=."
  }
}
