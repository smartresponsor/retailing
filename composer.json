{
  "name": "retailing/retail",
  "description": "Retail marketplace product component",
  "type": "symfony-bundle",
  "license": "PolyForm-Noncommercial-1.0.0",
  "require": {
    "php": "^8.4",
    "cataloging/catalog": "dev-feature/cataloging-post-merge-20260921-v2",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "tabling/table": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "interfacing/interface": "dev-master",
    "locating/location": "dev-env/locating-l2",
    "objecting/object": "dev-master",
    "pricing/price": "dev-master",
    "stocking/stock": "dev-master",
    "symfony/dependency-injection": "^8.1",
    "symfony/form": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/options-resolver": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/validator": "^8.1",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": "^3.95",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/panther": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "App\\Retailing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Retailing\\Tests\\": "tests/"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Administering",
      "options": {
        "symlink": true,
        "versions": {
          "administering/administration": "dev-master"
        }
      }
    },
    {
      "type": "vcs",
      "url": "../Cataloging"
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "vcs",
      "url": "../Locating"
    },
    {
      "type": "vcs",
      "url": "../Navigating"
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "vcs",
      "url": "../Pricing"
    },
    {
      "type": "vcs",
      "url": "../Stocking"
    },
    {
      "type": "vcs",
      "url": "../Currencing"
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "phpstan": "phpstan analyse -c phpstan.neon",
    "test": "phpunit",
    "test:coverage": "@php tools/coverage/retail-php-coverage.php --coverage-text=var/coverage.txt",
    "test:coverage:path": "@php -d xdebug.mode=coverage vendor/bin/phpunit --coverage-text=var/coverage/phpunit-path.txt --path-coverage",
    "test:behavioral-coverage": "@php tools/coverage/retail-behavioral-coverage.php",
    "schema:parity": [
      "php bin/console doctrine:schema:validate --env=test",
      "php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "gate": "@php vendor/bin/gating check --target=. --profile=config/retail_gating_profile.yaml --policy-root=vendor/gating/gate/.gating --severity-config=vendor/gating/gate/.gating/config/severity.yaml",
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test",
      "@gate"
    ]
  }
}
